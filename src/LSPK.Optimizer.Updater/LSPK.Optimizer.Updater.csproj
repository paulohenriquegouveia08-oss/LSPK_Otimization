<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LSPK.Optimizer.Updater</RootNamespace>
    <AssemblyName>LSPK.Optimizer.Updater</AssemblyName>
    <Version>1.0.0</Version>
    <Company>LSPK Technology</Company>
    <Product>LSPK Optimizer Updater</Product>
    <Description>Atomic Update and Rollback Engine for LSPK Optimizer</Description>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LSPK.Optimizer.Core\LSPK.Optimizer.Core.csproj" />
  </ItemGroup>
</Project>
