<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LSPK.Optimizer.Installer</RootNamespace>
    <AssemblyName>LSPKOptimizerSetup</AssemblyName>
    <Version>1.0.0</Version>
    <Company>LSPK Technology</Company>
    <Product>LSPK Optimizer Setup</Product>
    <Description>Standalone Setup and Uninstaller for LSPK Optimizer</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
  </ItemGroup>
</Project>
