<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LSPK.Optimizer.Installer</RootNamespace>
    <AssemblyName>LSPKOptimizerSetup</AssemblyName>
    <Version>1.0.0</Version>
    <Company>LSPK Technology</Company>
    <Product>LSPK Optimizer Setup</Product>
    <Description>Instalador Oficial do LSPK Optimizer</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inclui o payload.zip quando presente gerado pelo pipeline de empacotamento -->
    <EmbeddedResource Include="payload.zip" Condition="Exists('$(MSBuildThisFileDirectory)payload.zip')" />
  </ItemGroup>
</Project>
