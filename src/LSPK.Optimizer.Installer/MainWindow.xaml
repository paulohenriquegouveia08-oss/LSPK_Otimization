<Window x:Class="LSPK.Optimizer.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalação do LSPK Optimizer"
        Height="500" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#0B0F17"
        MouseLeftButtonDown="Window_MouseDown">

    <!-- Configuração de WindowChrome para visual moderno sem bordas padrão e sem bugs de transparência D3D -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      CornerRadius="16"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushCyan}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Topo com Logo e Marca -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource BrushGradientLspk}" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconBolt}" Width="18" Height="18" Fill="#060C17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LSPK OPTIMIZER" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="LSPK Technology • Instalador Oficial" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="Close_Click" Cursor="Hand">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stroke="{StaticResource BrushTextMuted}" StrokeThickness="1.5" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- ETAPA 1: Boas-vindas e Configurações -->
            <Grid x:Name="StepWelcome" Grid.Row="1" Visibility="Visible">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Otimização Profissional do Windows" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="O LSPK Optimizer diagnostica e elimina caches residuais, otimiza programas de inicialização e recupera o desempenho do seu PC com segurança máxima."
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,8,0,24" LineHeight="19"/>

                    <Border Background="#0C1322" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="DIRETÓRIO DE INSTALAÇÃO (POR USUÁRIO)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                            <TextBlock x:Name="TxtInstallPath" Text="%LocalAppData%\Programs\LSPK Optimizer" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkDesktopShortcut" Content="Criar atalho na Área de Trabalho" IsChecked="True" Foreground="{StaticResource BrushTextSecondary}" FontSize="13"/>
                </StackPanel>
            </Grid>

            <!-- ETAPA 2: Barra de Progresso Real -->
            <Grid x:Name="StepInstalling" Grid.Row="1" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Instalando o LSPK Optimizer..." FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock x:Name="TxtStepDetail" Text="Extraindo arquivos da aplicação..." FontSize="13" Foreground="{StaticResource BrushCyan}" Margin="0,6,0,20"/>

                    <ProgressBar x:Name="PrgInstall" Height="10" Background="#1E293B" Foreground="{StaticResource BrushGradientLspk}" Maximum="100" Value="0" Margin="0,0,0,10"/>

                    <Grid>
                        <TextBlock x:Name="TxtFilesProgress" Text="0 / 0 arquivos processados" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock x:Name="TxtBytesProgress" Text="0 MB / 0 MB" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ETAPA 3: Instalação Concluída -->
            <Grid x:Name="StepCompleted" Grid.Row="1" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#15382B" BorderBrush="{StaticResource BrushGreen}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="{StaticResource IconCheck}" Width="28" Height="28" Stroke="{StaticResource BrushGreen}" StrokeThickness="3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Instalação Concluída!" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="O LSPK Optimizer está pronto para ser utilizado." FontSize="13" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,24"/>
                    <CheckBox x:Name="ChkLaunchApp" Content="Iniciar o LSPK Optimizer agora" IsChecked="True" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Rodapé / Botões de Ação -->
            <Grid Grid.Row="2">
                <Button x:Name="BtnCancel" Style="{StaticResource ButtonSecondary}" Content="Cancelar" HorizontalAlignment="Left" Click="Close_Click"/>

                <Button x:Name="BtnInstall" Style="{StaticResource ButtonPrimary}" Content="Instalar Agora" HorizontalAlignment="Right" Click="Install_Click"/>
                <Button x:Name="BtnFinish" Style="{StaticResource ButtonPrimary}" Content="Concluir" HorizontalAlignment="Right" Visibility="Collapsed" Click="Finish_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
