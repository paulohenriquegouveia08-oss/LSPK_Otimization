<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LSPK.Optimizer.App</RootNamespace>
    <AssemblyName>LSPK.Optimizer.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Company>LSPK Technology</Company>
    <Product>LSPK Optimizer</Product>
    <Description>LSPK Optimizer - Professional Windows Optimization Suite</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LSPK.Optimizer.Core\LSPK.Optimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
</Project>
