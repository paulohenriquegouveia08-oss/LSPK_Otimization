<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta de Cores Oficial LSPK Technology -->
    <Color x:Key="ColorVoid">#0B0F17</Color>
    <Color x:Key="ColorSurface">#131B2E</Color>
    <Color x:Key="ColorSurfaceLight">#1B253D</Color>
    <Color x:Key="ColorBorder">#1E293B</Color>
    <Color x:Key="ColorBorderHighlight">#334155</Color>

    <!-- Acentos Tecnológicos -->
    <Color x:Key="ColorCyan">#00F2FE</Color>
    <Color x:Key="ColorBlue">#4FACFE</Color>
    <Color x:Key="ColorGreen">#10B981</Color>
    <Color x:Key="ColorAmber">#F59E0B</Color>
    <Color x:Key="ColorRed">#EF4444</Color>

    <!-- Tipografia -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushVoid" Color="{StaticResource ColorVoid}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceLight" Color="{StaticResource ColorSurfaceLight}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorBorderHighlight}"/>

    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorCyan}"/>
    <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource ColorBlue}"/>
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}"/>
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}"/>
    <SolidColorBrush x:Key="BrushRed" Color="{StaticResource ColorRed}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

    <!-- Gradiente de Ação Principal LSPK -->
    <LinearGradientBrush x:Key="BrushGradientLspk" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F2FE" Offset="0.0"/>
        <GradientStop Color="#4FACFE" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38F9D7" Offset="0.0"/>
        <GradientStop Color="#43E97B" Offset="1.0"/>
    </LinearGradientBrush>
</ResourceDictionary>
