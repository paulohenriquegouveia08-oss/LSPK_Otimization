<Window x:Class="LSPK.Optimizer.App.Views.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatório de Otimização — LSPK Optimizer"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushCyan}"
            BorderThickness="1.5"
            CornerRadius="16"
            Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ícone e Título de Sucesso -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="64" Height="64" CornerRadius="32" Background="#163832" BorderBrush="{StaticResource BrushGreen}" BorderThickness="2" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconCheck}" Width="26" Height="26" Stroke="{StaticResource BrushGreen}" StrokeThickness="3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Otimização Concluída com Sucesso!" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Seu Windows foi limpo e ajustado de acordo com as regras de segurança." FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Grid de Métricas Principais -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Espaço Físico Recuperado -->
                <Border Grid.Column="0" Background="#0F1829" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ESPAÇO LIBERADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                        <TextBlock x:Name="TxtBytesFreed" Text="0 MB" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushGreen}" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtFilesDeleted" Text="0 arquivos excluídos" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Score de Saúde Final -->
                <Border Grid.Column="2" Background="#0F1829" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NOVA SAÚDE DO SISTEMA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                        <TextBlock x:Name="TxtHealthScore" Text="95 / 100" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtStartupOptimized" Text="0 inicializadores ajustados" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Botão Concluir -->
            <Button Grid.Row="2" Style="{StaticResource ButtonPrimaryLspk}"
                    Content="Entendido e Fechar"
                    Click="Close_Click"
                    Height="44"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
