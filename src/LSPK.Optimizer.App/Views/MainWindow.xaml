<Window x:Class="LSPK.Optimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LSPK.Optimizer.App.ViewModels"
        xmlns:views="clr-namespace:LSPK.Optimizer.App.Views"
        mc:Ignorable="d"
        Title="LSPK Optimizer"
        Height="780" Width="1240"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushVoid}"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Barra de Título Customizada (Draggable) -->
            <Border Grid.Row="0" Background="#080C14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo e Marca -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource BrushGradientLspk}" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconBolt}" Fill="#060C17" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="LSPK OPTIMIZER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="#162238" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}"/>
                        </Border>
                    </StackPanel>

                    <!-- Botões de Janela -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowControlButton}" Content="—" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowControlButton}" Content="□" Click="Maximize_Click"/>
                        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click">
                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Alerta de Atualização Automática Não-Intrusivo -->
            <Border Grid.Row="1" Background="#142C48" BorderBrush="{StaticResource BrushCyan}" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding IsUpdateAvailable, Converter={x:Null}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconUpdate}" Stroke="{StaticResource BrushCyan}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nova atualização disponível (" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding UpdateVersion}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                        <TextBlock Text="). O pacote foi verificado via SHA-256 e está pronto." FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource ButtonPrimaryLspk}"
                            Content="Reiniciar e Atualizar"
                            Command="{Binding ApplyUpdateCommand}"
                            Padding="16,6" FontSize="12"/>
                </Grid>
            </Border>

            <!-- 3. Corpo Principal (Sidebar + Conteúdo Dinâmico) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Barra Lateral de Navegação -->
                <Border Grid.Column="0" Background="#0C121E" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" Padding="16,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sub-cabeçalho de Navegação -->
                        <TextBlock Grid.Row="0" Text="NAVEGAÇÃO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="8,0,0,12"/>

                        <!-- Menus -->
                        <StackPanel Grid.Row="1">
                            <RadioButton Style="{StaticResource SidebarNavButton}"
                                         IsChecked="{Binding IsDashboardActive}"
                                         Command="{Binding NavigateDashboardCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavButton}"
                                         IsChecked="{Binding IsCleanerActive}"
                                         Command="{Binding NavigateCleanerCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Limpeza de Arquivos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavButton}"
                                         IsChecked="{Binding IsStartupActive}"
                                         Command="{Binding NavigateStartupCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRocket}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inicialização" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SidebarNavButton}"
                                         IsChecked="{Binding IsHistoryActive}"
                                         Command="{Binding NavigateHistoryCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconClock}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Histórico" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Rodapé Institucional -->
                        <Border Grid.Row="2" Background="#111A2C" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="LSPK Technology" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Ambiente Seguro • Zero Telemetria" FontSize="10" Foreground="{StaticResource BrushGreen}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Área Central de Conteúdo -->
                <Grid Grid.Column="1">
                    <!-- View Dashboard -->
                    <views:DashboardView DataContext="{Binding}"
                                         Visibility="{Binding IsDashboardActive, Converter={x:Null}}"/>

                    <!-- View Limpeza -->
                    <views:CleanerView DataContext="{Binding CleanerVM}"
                                       Visibility="{Binding IsCleanerActive, Converter={x:Null}}"/>

                    <!-- View Inicialização -->
                    <views:StartupView DataContext="{Binding StartupVM}"
                                       Visibility="{Binding IsStartupActive, Converter={x:Null}}"/>

                    <!-- View Histórico -->
                    <views:HistoryView DataContext="{Binding HistoryVM}"
                                       Visibility="{Binding IsHistoryActive, Converter={x:Null}}"/>

                    <!-- Overlay de Otimização em Tempo Real (Exibido durante 'Otimizar Agora') -->
                    <Border Background="#EB070D18"
                            Visibility="{Binding IsOptimizing, Converter={x:Null}}">
                        <Border Style="{StaticResource CardLspk}" Background="#111A2E" Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
                            <StackPanel>
                                <TextBlock Text="OTIMIZAÇÃO EM ANDAMENTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                                <TextBlock Text="{Binding OptimizationTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding OptimizationDetail}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20"/>

                                <ProgressBar Style="{StaticResource ProgressLspk}" Value="{Binding OptimizationPercent}" Maximum="100" Height="8" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,24">
                                    <TextBlock Text="{Binding OptimizationStep, StringFormat='Etapa {0} de 9'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding OptimizationPercent, StringFormat='{}{0:N0}%'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Button Style="{StaticResource ButtonSecondaryLspk}"
                                        Content="Cancelar Otimização"
                                        Command="{Binding CancelOptimizationCommand}"
                                        HorizontalAlignment="Center"
                                        Padding="20,8"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
