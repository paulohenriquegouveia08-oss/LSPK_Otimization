<UserControl x:Class="LSPK.Optimizer.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LSPK.Optimizer.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:StartupViewModel}"
             Background="Transparent">

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Módulo 2 — Gerenciamento de Inicialização" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Acelere o tempo de boot do Windows desativando programas desnecessários com backup automático." FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ButtonSecondaryLspk}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource BrushTextPrimary}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ButtonSecondaryLspk}" Command="{Binding CleanOrphansCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBroom}" Stroke="{StaticResource BrushTextPrimary}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Remover Órfãos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barra de Busca e Filtro -->
        <Border Grid.Row="1" Style="{StaticResource CardLspk}" Margin="0,0,0,16" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#0E1626" Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorderHighlight}" Padding="10,6"
                         VerticalAlignment="Center" FontSize="13"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveCount, StringFormat='Ativos: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushGreen}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding OrphanCount, StringFormat='Órfãos: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushRed}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela / Lista de Inicializadores -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardLspk}" Margin="0,0,0,8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <!-- Toggle Switch de Habilitação -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <!-- Nome e Fabricante -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <Path Data="{StaticResource IconShield}" Width="12" Height="12" Stroke="{StaticResource BrushCyan}" StrokeThickness="1.5" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Componente Essencial Protegido pelo Sistema"
                                              Visibility="{Binding IsSystemProtected, Converter={x:Null}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{StaticResource BrushCyan}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Caminho / Comando -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SourceDescription}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Alertas de Status / Órfão -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border Background="#3B1818" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Visibility="{Binding IsOrphaned, Converter={x:Null}}">
                                        <TextBlock Text="Arquivo Inexistente" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushRed}"/>
                                    </Border>
                                    <TextBlock Text="Destino Válido" FontSize="11" Foreground="{StaticResource BrushGreen}"
                                               Visibility="{Binding TargetExists, Converter={x:Null}}"/>
                                </StackPanel>

                                <!-- Impacto -->
                                <Border Grid.Column="4" Background="#1A2840" CornerRadius="4" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Impact, StringFormat='Impacto {0}'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
